{
  "name": "agents-in-practice",
  "version": "0.1.0",
  "private": true,
  "description": "A daily, searchable feed of real-world AI agent applications with original-source attribution.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "curate": "node scripts/curate.mjs",
    "daily": "node scripts/collect.mjs && node scripts/curate.mjs",
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "check": "node scripts/validate.mjs && node scripts/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "zod": "^4.0.0"
  }
}
